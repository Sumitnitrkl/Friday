# FRIDAY Environment Variables
# Rename this file to .env and fill in your values.
# This file is loaded automatically by the start scripts.
# Never commit this file to git — add .env to your .gitignore

# Claude API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your-claude-api-key-here

# Optional: OpenAI key if you want GPT fallback
# OPENAI_API_KEY=your-openai-key-here

# Optional: ElevenLabs for ultra-realistic voice
# ELEVENLABS_API_KEY=your-elevenlabs-key-here
