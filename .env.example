# FRIDAY Environment Variables
# Rename this file to .env and fill in your values.
# .env is loaded automatically on startup and is gitignored — never commit it.

# ── FREE AI: Groq (recommended, no credit card) ──
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Claude API key (optional, paid) — get from https://console.anthropic.com
# ANTHROPIC_API_KEY=your-claude-api-key-here

# Optional: ElevenLabs for ultra-realistic voice
# ELEVENLABS_API_KEY=your-elevenlabs-key-here
